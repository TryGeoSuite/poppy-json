{
  "protocol_version": "0.3",
  "organization": {
    "name": "Acme",
    "domain": "acme.com"
  },
  "auth": {
    "issuer": "https://auth.acme.com",
    "scopes": {
      "orders:read": "See your orders and returns",
      "orders:write": "Return or exchange items"
    }
  },
  "agent": {
    "protocols": [
      {
        "type": "poppy",
        "endpoint": "https://api.acme.com/poppy/conversations"
      }
    ]
  },
  "apis": [
    {
      "type": "mcp",
      "url": "https://mcp.acme.com/mcp",
      "description": "Orders, returns and saved addresses"
    },
    {
      "type": "openapi",
      "url": "https://api.acme.com/openapi.json",
      "description": "Orders and returns API"
    }
  ],
  "web": {
    "browser_session_endpoint": "https://acme.com/poppy/browser-session"
  }
}
